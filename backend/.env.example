# Salin file ini jadi `.env` lalu isi nilainya. JANGAN commit .env asli.

# Port server HTTP. Default 8080 kalau dikosongkan.
# Jika port 8080 sudah terpakai, set PORT=8081 (cocok dengan default frontend).
PORT=8080

# PostgreSQL connection string (database: nusapath)
DATABASE_URL=postgres://postgres@localhost:5432/nusapath?sslmode=disable

# Minimal 32 karakter — JWT signing key. JANGAN pakai default.
JWT_SECRET=

# Google Gemini API key untuk /api/smart-trip
GEMINI_API_KEY=

# Pinata JWT untuk pin tiket ke IPFS
PINATA_JWT=

# "production" mengaktifkan cookie Secure (wajib HTTPS). Kosongkan untuk dev.
APP_ENV=
